@page "/sessions/{Id:guid}"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject LiveEventsClient Live
@inject AuthState Auth

<PageTitle>Session @Sessions.ShortId(Id) — IntelligenceKit</PageTitle>

<a class="small text-muted text-decoration-none d-inline-block mb-3" href="sessions">&larr; Sessions</a>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_notFound)
{
    <div class="alert alert-warning">Session not found (or not visible with this key).</div>
}
else if (_session is null)
{
    <p class="text-muted">Loading session…</p>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-3 mb-1">
        <h1 class="page-title mb-0">Session <span class="font-monospace text-muted">#@Sessions.ShortId(_session.Id)</span></h1>
        <SessionStatusBadge Session="_session" />
        @if (IsRunning)
        {
            <span class="live-pill @(_live ? "on" : "off")">
                <span class="live-dot @(_live ? "on" : "")"></span> @(_live ? "Live" : "Offline")
            </span>
        }
    </div>
    <p class="text-muted mb-4">
        @DeviceLabel · @(string.IsNullOrEmpty(_session.OperatingSystem) ? _session.Platform : _session.OperatingSystem)
        · release <span class="font-monospace">@_session.Release</span>
        @if (!string.IsNullOrEmpty(_session.Environment))
        {
            <span> · @_session.Environment</span>
        }
    </p>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-label">Started</div><div class="stat-value fs-6">@_session.Started.ToLocalTime().ToString("g")</div></div></div>
        <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-label">@(IsRunning ? "Running for" : "Foreground time")</div><div class="stat-value">@Sessions.Duration(Sessions.DisplaySeconds(_session))</div></div></div>
        <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-label">Errors</div><div class="stat-value @(ErrorCount > 0 ? "danger" : "")">@ErrorCount</div></div></div>
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-label">User</div>
                <div class="stat-value fs-6 text-truncate">
                    @if (!string.IsNullOrEmpty(_session.UserId))
                    {
                        <a href="@($"users/{Uri.EscapeDataString(_session.UserId)}?projectId={Uri.EscapeDataString(_session.ProjectId)}")">@_session.UserId</a>
                    }
                    else
                    {
                        <span class="text-muted">anonymous</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h2 class="h5 mb-0 me-2">Timeline</h2>
        @foreach (var (category, count) in Counts)
        {
            <button type="button" class="tl-chip @(_hidden.Contains(category) ? "off" : "")" aria-pressed="@(!_hidden.Contains(category))"
                    @onclick="() => Toggle(category)">
                <span class="tl-dot cat-@category"></span>@CategoryLabel(category) <span class="text-muted">@count</span>
            </button>
        }
        <input class="form-control form-control-sm ms-auto" style="max-width: 16rem" placeholder="Filter steps…"
               @bind="_search" @bind:event="oninput" aria-label="Filter timeline" />
    </div>

    @if (_items.Count == 0)
    {
        <div class="alert alert-info">
            No timeline for this session. Turn on <code>EnableSessionTimeline</code> in the SDK options to record
            navigation, user actions, HTTP calls, logs and screenshots for every session.
            @if (_session.Errors > 0)
            {
                <span>Its errors are still listed under <a href="events">Events</a>.</span>
            }
        </div>
    }
    else
    {
        <ol class="tl">
            @foreach (var item in Visible)
            {
                var open = _open.Contains(item.Id);
                <li class="tl-item @(item.Kind == TimelineItem.EventKind && item.Category == "error" ? "is-event" : "") @(_fresh.Contains(item.Id) ? "is-new" : "")" @key="item.Id">
                    <button type="button" class="tl-row" aria-expanded="@open" @onclick="() => ToggleOpen(item)">
                        <span class="tl-time font-monospace">
                            @item.Timestamp.ToLocalTime().ToString("HH:mm:ss")<span class="text-muted">.@item.Timestamp.ToLocalTime().ToString("fff")</span>
                            <span class="tl-offset">+@Offset(item)</span>
                        </span>
                        <span class="tl-node cat-@item.Category"></span>
                        <span class="tl-badge cat-@item.Category">@CategoryLabel(item.Category)</span>
                        <span class="tl-main">
                            <span class="tl-title">@item.Message</span>
                            @if (Detail(item) is { } detail)
                            {
                                <span class="tl-detail">@detail</span>
                            }
                        </span>
                        @foreach (var fact in Facts(item))
                        {
                            <span class="tl-fact font-monospace @fact.Css">@fact.Text</span>
                        }
                    </button>

                    @if (open)
                    {
                        <div class="tl-body">
                            @if (item.ScreenshotId is { } shot)
                            {
                                <img class="screenshot-img tl-shot" src="@ScreenshotUrl(shot)" alt="Screenshot" loading="lazy"
                                     role="button" @onclick="() => _zoom = shot" />
                            }
                            @if (item.EventId is { } eventId)
                            {
                                <p class="mb-2">
                                    @if (item.ExceptionType is not null)
                                    {
                                        <span class="text-danger font-monospace">@item.ExceptionType</span>
                                        <span class="text-muted">— @item.ExceptionMessage</span>
                                    }
                                </p>
                                <a class="btn btn-outline-secondary btn-sm" href="@($"events/{eventId}")">Open event (stack trace, device state, breadcrumbs) &rarr;</a>
                            }
                            @if (item.Data is { Count: > 0 })
                            {
                                <dl class="tl-data font-monospace small mb-0">
                                    @foreach (var kv in item.Data)
                                    {
                                        <dt>@kv.Key</dt>
                                        <dd>@kv.Value</dd>
                                    }
                                </dl>
                            }
                            <div class="text-muted small mt-2">
                                @item.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff") · @item.Level
                                @if (item.Kind == TimelineItem.EntryKind)
                                {
                                    <span> · step @item.Sequence</span>
                                }
                            </div>
                        </div>
                    }
                </li>
            }
        </ol>

        @if (!Visible.Any())
        {
            <p class="text-muted text-center py-4">No steps match the current filters.</p>
        }
        @if (_truncated)
        {
            <p class="text-muted small">Only the first @_items.Count(i => i.Kind == TimelineItem.EntryKind) steps are shown.</p>
        }
        @if (IsRunning && _live)
        {
            <p class="tl-listening small text-muted"><span class="live-dot on"></span> Listening for new activity…</p>
        }
    }

    @if (_zoom is { } zoomed)
    {
        <div class="screenshot-overlay" @onclick="() => _zoom = null">
            <img src="@ScreenshotUrl(zoomed)" alt="Screenshot (full size)" />
            <button type="button" class="screenshot-close" aria-label="Close">&times;</button>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SessionSummary? _session;
    private List<TimelineItem> _items = new();
    private bool _truncated;
    private bool _notFound;
    private string? _error;
    private bool _live;
    private string _search = string.Empty;
    private Guid? _zoom;
    private readonly HashSet<string> _hidden = new();
    private readonly HashSet<Guid> _open = new();
    private readonly HashSet<Guid> _fresh = new();

    private bool IsRunning => _session is { Status: "Ok", IsAbnormal: false };

    // The session's own counter only moves with lifecycle updates; errors on the timeline are current.
    private int ErrorCount => Math.Max(_session?.Errors ?? 0, _items.Count(i => i.Kind == TimelineItem.EventKind && i.Category == "error"));

    private string DeviceLabel => _session is null ? "" :
        !string.IsNullOrEmpty(_session.DeviceModel) ? $"{_session.Manufacturer} {_session.DeviceModel}".Trim() : _session.Platform;

    private IEnumerable<(string Category, int Count)> Counts
        => _items.GroupBy(i => i.Category).Select(g => (g.Key, g.Count())).OrderBy(c => Order(c.Key));

    private IEnumerable<TimelineItem> Visible
        => _items.Where(i => !_hidden.Contains(i.Category)
                             && (_search.Length == 0
                                 || i.Message.Contains(_search, StringComparison.OrdinalIgnoreCase)
                                 || (i.ExceptionMessage?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync()
    {
        Live.TimelineReceived += OnTimeline;
        Live.EventReceived += OnEvent;
        Live.SessionUpdated += OnSession;
        try
        {
            await Live.EnsureStartedAsync();
            _live = Live.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
        }
        catch
        {
            _live = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _session = null;
        _items = new();
        _open.Clear();
        _fresh.Clear();
        _notFound = false;
        _error = null;
        try
        {
            var result = await Api.GetSessionTimelineAsync(Id);
            if (result is null)
            {
                _notFound = true;
                return;
            }
            _session = result.Session;
            _items = result.Items.ToList();
            _truncated = result.Truncated;
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the API: {ex.Message}";
        }
    }

    private void OnTimeline(TimelinePush push)
    {
        if (push.SessionId != Id || _session is null)
            return;
        Add(push.Items);
    }

    private void OnEvent(EventSummary e)
    {
        if (e.SessionId != Id || _session is null)
            return;
        Add([TimelineFromEvent(e)]);
    }

    private void OnSession(SessionSummary s)
    {
        if (s.Id != Id)
            return;
        _session = s;
        InvokeAsync(StateHasChanged);
    }

    private void Add(IEnumerable<TimelineItem> incoming)
    {
        var added = false;
        foreach (var item in incoming)
        {
            if (_items.Any(i => i.Id == item.Id))
                continue;

            // A log call yields a breadcrumb and an event; keep only the event (it links to details).
            // Events are sent at once, timeline batches every few seconds, so either may come first.
            if (_items.Any(existing => TimelineItem.IsSameLog(item, existing)))
                continue;
            _items.RemoveAll(existing => TimelineItem.IsSameLog(existing, item));

            _items.Add(item);
            _fresh.Add(item.Id);
            added = true;
        }

        if (!added)
            return;

        _items = _items.OrderBy(i => i.Timestamp).ThenBy(i => i.Sequence).ToList();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Same shape the server uses for errors on the timeline.</summary>
    private static TimelineItem TimelineFromEvent(EventSummary e)
        => new(TimelineItem.EventKind, e.Id, e.Timestamp, long.MaxValue,
            e.EventType == "Log" ? "log" : "error",
            e.ExceptionType ?? e.Message ?? e.EventType,
            e.Level ?? "Error", null, e.Id, e.EventType, e.ExceptionType, e.ExceptionMessage, EventMessage: e.Message);

    public void Dispose()
    {
        Live.TimelineReceived -= OnTimeline;
        Live.EventReceived -= OnEvent;
        Live.SessionUpdated -= OnSession;
    }

    private void Toggle(string category)
    {
        if (!_hidden.Remove(category))
            _hidden.Add(category);
    }

    private void ToggleOpen(TimelineItem item)
    {
        if (!_open.Remove(item.Id))
            _open.Add(item.Id);
    }

    private string Offset(TimelineItem item)
    {
        var seconds = Math.Max(0, (item.Timestamp - _session!.Started).TotalSeconds);
        return seconds < 60 ? $"{seconds:0.0}s" : Sessions.Duration(seconds);
    }

    private string ScreenshotUrl(Guid batchId)
    {
        // An <img> can't send an Authorization header, so the token rides as a query parameter.
        var url = $"{Api.BaseAddress}events/{batchId}/screenshot";
        return Auth.HasToken ? $"{url}?access_token={Uri.EscapeDataString(Auth.Token!)}" : url;
    }

    private static string? Detail(TimelineItem item)
    {
        if (item.Kind == TimelineItem.EventKind)
            return item.ExceptionMessage;
        if (item.Data is null)
            return null;
        if (item.Data.TryGetValue("error", out var error))
            return error;
        return item.Category == "screenshot" && item.Data.TryGetValue("screen", out var screen) ? $"on {screen}" : null;
    }

    private static IEnumerable<(string Text, string Css)> Facts(TimelineItem item)
    {
        if (item.Category == "http" && item.Data is not null)
        {
            if (item.Data.TryGetValue("status_code", out var status) && int.TryParse(status, out var code))
                yield return (status, code >= 500 ? "text-danger" : code >= 400 ? "text-warning" : "text-success");
            else if (item.Data.ContainsKey("error"))
                yield return ("failed", "text-danger");
            if (item.Data.TryGetValue("duration_ms", out var ms) && int.TryParse(ms, out var duration))
                yield return ($"{duration:N0}ms", "text-muted");
        }
        else if (item.Level is "Warning" or "Error" or "Critical")
        {
            yield return (item.Level, item.Level == "Warning" ? "text-warning" : "text-danger");
        }
    }

    private static string CategoryLabel(string category) => category switch
    {
        "navigation" => "Screen",
        "user" => "Action",
        "http" => "HTTP",
        "log" => "Log",
        "error" => "Error",
        "screenshot" => "Screenshot",
        "system" => "System",
        _ => category,
    };

    private static int Order(string category) => category switch
    {
        "navigation" => 0, "user" => 1, "http" => 2, "log" => 3, "error" => 4, "screenshot" => 5, "system" => 6, _ => 7,
    };
}
