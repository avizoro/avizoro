{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Database:Provider = Sqlite (default) | PostgreSql | SqlServer.
  // ConnectionStrings:Events is optional for Sqlite (defaults to a local file)
  // and required for PostgreSql / SqlServer.
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Events": "Data Source=avizoro.db"
  },

  // Auth:ReadToken gates the read API (GET endpoints + the SignalR hub) and the
  // dashboard. Ingest (POST /events) stays open — the client project key is a
  // public routing id, not a secret.
  // Empty here: reads are OPEN in Development and LOCKED in Production. Set a
  // strong value (e.g. "avizoro_admin_<random>") before exposing the server.
  "Auth": {
    "ReadToken": ""
  },

  // Ingest gating. When true, POST /events only accepts events whose
  // (projectId, projectKey) pair matches a project registered via
  // POST /admin/projects; unknown projects get 404. Set false to keep ingest
  // fully open (the pre-scoping behaviour).
  "Ingest": {
    "RequireKnownProject": true
  },

  // Data retention: a background sweep prunes events/screenshots (by ReceivedAt)
  // and stale issues (by LastSeen) older than Days. OFF by default — opt in so a
  // fresh install never silently deletes data. Days must be > 0.
  "Retention": {
    "Enabled": false,
    "Days": 90,
    "SweepHours": 6
  },

  // Alerts: rules (managed via /alerts/rules, admin-only) fire on new issues,
  // regressions or event-rate thresholds and post to a webhook / Slack / Teams /
  // Discord, or send email through the SMTP server below. DashboardUrl is used to
  // put a "open issue" link in every alert.
  "Alerts": {
    "DashboardUrl": "http://localhost:5292",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "User": "",
      "Password": "",
      "From": ""
    }
  },

  // Issue trackers for "create GitHub/Jira issue" on an issue. GitHub: with only
  // Repository set, the dashboard opens a prefilled new-issue form; add a Token
  // (fine-grained, Issues: write) to create it via the API. Jira Cloud: BaseUrl
  // (https://you.atlassian.net), Email + ApiToken, ProjectKey, IssueType.
  "Integrations": {
    "GitHub": { "Repository": "", "Token": "" },
    "Jira": { "BaseUrl": "", "Email": "", "ApiToken": "", "ProjectKey": "", "IssueType": "Bug" }
  },

  // Server observability. Health probes: /health/live, /health/ready (no auth).
  // Prometheus: GET /metrics (admin token unless RequireAuth=false). OTLP: set
  // Endpoint (e.g. http://otel-collector:4317) to push metrics and traces.
  "Telemetry": {
    "Prometheus": { "Enabled": true, "RequireAuth": true },
    "Otlp": { "Endpoint": "" }
  },

  // Demo instances: Seed fills an EMPTY database with sample data on startup;
  // ReadOnly rejects all writes (pair it with a public Auth:ReadToken).
  "Demo": {
    "Seed": false,
    "ReadOnly": false
  },

  // Per-client-IP rate limit on the open ingest endpoints (POST /events and the
  // screenshot upload). A throttled client gets 429 + Retry-After; the SDK
  // retries later (store-and-forward), so events are deferred, not lost. Set
  // Enabled=false to turn it off, or raise PermitLimit for shared-NAT clients.
  "RateLimit": {
    "Ingest": {
      "Enabled": true,
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}
