@page "/issues"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject LiveEventsClient Live

<PageTitle>Issues — Avizoro</PageTitle>

<div class="d-flex align-items-center gap-3 mb-4">
    <h1 class="page-title">Issues</h1>
    <span class="live-pill @(_live ? "on" : "off")">
        <span class="live-dot @(_live ? "on" : "")"></span> @(_live ? "Live" : "Offline")
    </span>
</div>

@if (!string.IsNullOrWhiteSpace(Release))
{
    <div class="alert alert-secondary py-2 small d-flex align-items-center gap-2">
        Showing issues introduced in release <code>@Release</code>
        <a class="ms-auto" href="@TabUrl(_status, withRelease: false)">clear</a>
    </div>
}

<ul class="nav nav-pills mb-3">
    @foreach (var (label, value) in StatusTabs)
    {
        <li class="nav-item">
            <a class="nav-link py-1 px-3 @(string.Equals(_status, value, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@TabUrl(value)">@label</a>
        </li>
    }
</ul>

<div class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label small text-muted mb-1">Search</label>
        <input class="form-control form-control-sm" placeholder="title or culprit…"
               @bind="_q" @bind:event="oninput" @onkeydown="OnSearchKey" />
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label small text-muted mb-1">Project</label>
        <input class="form-control form-control-sm" placeholder="all projects"
               @bind="_projectId" @bind:event="oninput" />
    </div>
    <div class="col-6 col-md-2">
        <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">Apply</button>
    </div>
    <div class="col-6 col-md-2">
        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilters">Clear</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_page is null)
{
    <p class="text-muted">Loading issues…</p>
}
else if (_page.Items.Count == 0)
{
    <div class="alert alert-info">No issues yet — grouped problems appear here as events arrive.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>Issue</th>
                    <th>Status</th>
                    <th>Type</th>
                    <th class="text-end">Events</th>
                    <th class="text-center">Trend</th>
                    <th>First seen</th>
                    <th>Last seen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in _page.Items)
                {
                    <tr role="button" @onclick="() => Open(i.Id)">
                        <td>
                            <div class="fw-semibold text-danger">@i.Title</div>
                            @if (!string.IsNullOrWhiteSpace(i.Culprit))
                            {
                                <div class="text-muted small">@i.Culprit</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(i.AssignedTo))
                            {
                                <div class="small">&#128100; @i.AssignedTo</div>
                            }
                        </td>
                        <td class="text-nowrap"><IssueStatusBadge Issue="i" /></td>
                        <td><span class="badge @BadgeClass(i.EventType)">@i.EventType</span></td>
                        <td class="text-end fw-semibold">@i.EventCount</td>
                        <td class="text-center">
                            @if (i.RecentCount > i.PreviousCount)
                            {
                                <span class="text-danger" title="rising">▲</span>
                            }
                            else if (i.RecentCount < i.PreviousCount)
                            {
                                <span class="text-success" title="falling">▼</span>
                            }
                            else
                            {
                                <span class="text-muted" title="steady">–</span>
                            }
                        </td>
                        <td class="text-nowrap small text-muted" title="@i.FirstSeen.ToLocalTime().ToString("F")">
                            @Ago(i.FirstSeen)
                        </td>
                        <td class="text-nowrap small" title="@i.LastSeen.ToLocalTime().ToString("F")">
                            @Ago(i.LastSeen)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <div class="text-muted small">
            Showing @(_skip + 1)–@(_skip + _page.Items.Count) of @_page.Total
        </div>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm" @onclick="Prev" disabled="@(_skip == 0)">Previous</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Next" disabled="@(!HasNext)">Next</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? ProjectId { get; set; }

    /// <summary>Status tab; "all" shows every status. Defaults to the triage inbox.</summary>
    [SupplyParameterFromQuery] public string? Status { get; set; }

    /// <summary>Only issues first seen in this release (linked from the Releases page).</summary>
    [SupplyParameterFromQuery] public string? Release { get; set; }

    [SupplyParameterFromQuery] public string? Q { get; set; }

    private string? _q;

    private static readonly (string Label, string Value)[] StatusTabs =
    [
        ("Unresolved", "Unresolved"), ("Resolved", "Resolved"), ("Ignored", "Ignored"), ("All", "all")
    ];

    private const int PageSize = 50;

    private string? _projectId;
    private string _status = "Unresolved";
    private int _skip;
    private PagedResult<IssueSummary>? _page;
    private string? _error;
    private bool _live;
    private bool _subscribed;

    private bool HasNext => _page is not null && _skip + _page.Items.Count < _page.Total;

    protected override async Task OnInitializedAsync()
    {
        Live.IssueUpserted += OnIssueUpserted;
        _subscribed = true;
        try
        {
            await Live.EnsureStartedAsync();
            _live = Live.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
        }
        catch
        {
            _live = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _projectId = ProjectId;
        _q = Q;
        _status = string.IsNullOrWhiteSpace(Status) ? "Unresolved" : Status;
        _skip = 0;
        await LoadAsync();
    }

    private void OnIssueUpserted(IssueSummary issue)
    {
        // Live-update only the first page and only for the current project filter.
        if (_skip != 0 || _page is null)
            return;
        if (!string.IsNullOrWhiteSpace(Release) && issue.FirstRelease != Release)
            return;
        if (!string.IsNullOrWhiteSpace(_q) &&
            !issue.Title.Contains(_q, StringComparison.OrdinalIgnoreCase) &&
            !(issue.Culprit?.Contains(_q, StringComparison.OrdinalIgnoreCase) ?? false))
            return;
        if (!string.IsNullOrWhiteSpace(_projectId) &&
            !string.Equals(issue.ProjectId, _projectId, StringComparison.OrdinalIgnoreCase))
            return;

        // An issue that moved out of the current tab (e.g. resolved) leaves the list.
        if (!MatchesTab(issue))
        {
            if (_page.Items.Any(i => i.Id == issue.Id))
            {
                _page = _page with { Total = _page.Total - 1, Items = _page.Items.Where(i => i.Id != issue.Id).ToList() };
                InvokeAsync(StateHasChanged);
            }
            return;
        }

        var existing = _page.Items.FirstOrDefault(i => i.Id == issue.Id);
        var items = _page.Items.Where(i => i.Id != issue.Id).ToList();

        // The live payload carries no trend; keep the arrow sensible by bumping
        // the recent count off whatever we last knew.
        var recent = (existing?.RecentCount ?? 0) + 1;
        var refreshed = issue with { RecentCount = recent, PreviousCount = existing?.PreviousCount ?? 0 };

        items.Insert(0, refreshed);
        if (items.Count > PageSize)
            items = items.Take(PageSize).ToList();

        var total = existing is null ? _page.Total + 1 : _page.Total;
        _page = _page with { Total = total, Items = items };

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_subscribed)
            Live.IssueUpserted -= OnIssueUpserted;
    }

    private async Task LoadAsync()
    {
        _error = null;
        _page = null;
        try
        {
            _page = await Api.GetIssuesAsync(_projectId, _skip, PageSize, IsAll ? null : _status, Release, _q);
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the API: {ex.Message}";
        }
    }

    private bool IsAll => string.Equals(_status, "all", StringComparison.OrdinalIgnoreCase);

    private bool MatchesTab(IssueSummary issue)
        => IsAll || string.Equals(issue.Status, _status, StringComparison.OrdinalIgnoreCase);

    private string TabUrl(string status, bool withRelease = true)
    {
        var url = $"/issues?status={Uri.EscapeDataString(status)}";
        if (!string.IsNullOrWhiteSpace(_projectId))
            url += $"&projectId={Uri.EscapeDataString(_projectId)}";
        if (withRelease && !string.IsNullOrWhiteSpace(Release))
            url += $"&release={Uri.EscapeDataString(Release)}";
        if (!string.IsNullOrWhiteSpace(_q))
            url += $"&q={Uri.EscapeDataString(_q)}";
        return url;
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            ApplyFilters();
    }

    private void ApplyFilters() => Nav.NavigateTo(TabUrl(_status));

    private void ClearFilters()
    {
        _q = null;
        Nav.NavigateTo($"/issues?status={Uri.EscapeDataString(_status)}");
    }

    private async Task Prev()
    {
        _skip = Math.Max(0, _skip - PageSize);
        await LoadAsync();
    }

    private async Task Next()
    {
        if (!HasNext) return;
        _skip += PageSize;
        await LoadAsync();
    }

    private void Open(Guid id) => Nav.NavigateTo($"/issues/{id}");

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    private static string BadgeClass(string eventType) => eventType switch
    {
        "Exception" => "text-bg-danger",
        "Log" => "text-bg-secondary",
        _ => "text-bg-light"
    };
}
