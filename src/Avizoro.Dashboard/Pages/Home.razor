@page "/"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject LiveEventsClient Live

<PageTitle>Overview — Avizoro</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div class="d-flex align-items-center gap-3">
        <h1 class="page-title">Overview</h1>
        <span class="live-pill @(_live ? "on" : "off")">
            <span class="live-dot @(_live ? "on" : "")"></span> @(_live ? "Live" : "Offline")
        </span>
    </div>
    <button class="avz-icon-btn w-auto" @onclick="LoadAsync" disabled="@_loading">
        @(_loading ? "Loading…" : "Refresh")
    </button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<!-- KPI tiles -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <div class="stat-label"><span class="stat-accent">●</span> Events · 24h</div>
            <div class="stat-value">@_windowTotal</div>
            <div class="stat-delta">@RenderDelta(_eventsRecent, _eventsPrev)</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <div class="stat-label"><span style="color:var(--avz-exception)">●</span> Exceptions · 24h</div>
            <div class="stat-value @(_windowExceptions > 0 ? "danger" : "")">@_windowExceptions</div>
            <div class="stat-delta">@RenderDelta(_excRecent, _excPrev)</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <div class="stat-label">Active issues</div>
            <div class="stat-value">@_issuesTotal</div>
            <div class="stat-delta">grouped problems</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile" title="Share of sessions in the last 14 days that did not end in a crash">
            <div class="stat-label">Crash-free sessions · 14d</div>
            @if (_crashFree?.CrashFreeSessionRate is { } rate)
            {
                <div class="stat-value @(rate < 0.99 ? "danger" : "")">@Percent(rate)</div>
                <div class="stat-delta">
                    @_crashFree.Sessions sessions · @(_crashFree.CrashFreeUserRate is { } u ? Percent(u) : "–") of @_crashFree.Users users
                </div>
            }
            else
            {
                <div class="stat-value">–</div>
                <div class="stat-delta">no sessions yet · @(_projects?.Count ?? 0) projects</div>
            }
        </div>
    </div>
</div>

<!-- Chart + donut -->
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <h2 class="section-title">Events per hour · last 24h</h2>
                    <div class="small">
                        <span class="me-3"><span class="legend-swatch total"></span> total @_windowTotal</span>
                        <span><span class="legend-swatch exception"></span> exceptions @_windowExceptions</span>
                    </div>
                </div>

                @if (_stats is null)
                {
                    <p class="text-muted mb-0">Loading chart…</p>
                }
                else if (_windowTotal == 0)
                {
                    <p class="text-muted mb-0">No events in the last 24 hours.</p>
                }
                else
                {
                    var max = Math.Max(1, _stats.Max(b => b.Total));
                    <svg class="events-chart" viewBox="0 0 @(_stats.Count * 10) 105" preserveAspectRatio="none"
                         role="img" aria-label="Events per hour">
                        @foreach (var gy in new[] { 25.0, 50.0, 75.0 })
                        {
                            <line x1="0" y1="@F(gy)" x2="@(_stats.Count * 10)" y2="@F(gy)" class="chart-grid" />
                        }
                        @for (var i = 0; i < _stats.Count; i++)
                        {
                            var b = _stats[i];
                            var x = i * 10 + 1.2;
                            var totalH = b.Total / (double)max * 100.0;
                            var exH = b.Exceptions / (double)max * 100.0;
                            var otherH = totalH - exH;
                            <g>
                                <title>@b.Start.ToLocalTime().ToString("HH:mm") — @b.Total total, @b.Exceptions exceptions</title>
                                @if (otherH > 0)
                                {
                                    <rect x="@F(x)" y="@F(100 - totalH)" width="7.6" height="@F(otherH)" rx="0.6" class="bar-total" />
                                }
                                @if (exH > 0)
                                {
                                    <rect x="@F(x)" y="@F(100 - exH)" width="7.6" height="@F(exH)" rx="0.6" class="bar-exception" />
                                }
                            </g>
                        }
                        <line x1="0" y1="100" x2="@(_stats.Count * 10)" y2="100" class="chart-axis" />
                    </svg>
                    <div class="d-flex justify-content-between text-muted small mt-1">
                        <span>@_stats[0].Start.ToLocalTime().ToString("HH:mm")</span>
                        <span>peak @max/h</span>
                        <span>now</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="section-title mb-3">Exception share · 24h</h2>
                @{
                    var excPct = _windowTotal > 0 ? (int)Math.Round(_windowExceptions * 100.0 / _windowTotal) : 0;
                    var otherCount = _windowTotal - _windowExceptions;
                }
                <div class="flex-grow-1 d-flex align-items-center">
                    <svg viewBox="0 0 42 42" class="donut" role="img" aria-label="Exception share">
                        <circle class="donut-track" cx="21" cy="21" r="15.9155" fill="none" stroke-width="4"></circle>
                        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="var(--avz-accent)" stroke-width="4"
                                stroke-dasharray="100 0"></circle>
                        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="var(--avz-exception)" stroke-width="4"
                                stroke-dasharray="@excPct @(100 - excPct)" stroke-dashoffset="25"
                                stroke-linecap="butt"></circle>
                        <text x="21" y="21" text-anchor="middle" class="donut-center-value" font-size="8">@excPct%</text>
                        <text x="21" y="26.5" text-anchor="middle" class="donut-center-label" font-size="2.8">EXCEPTIONS</text>
                    </svg>
                </div>
                <div class="d-flex justify-content-around small mt-2">
                    <span><span class="legend-swatch exception"></span> exceptions @_windowExceptions</span>
                    <span><span class="legend-swatch total"></span> other @otherCount</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Top issues -->
@if (_topIssues is { Count: > 0 })
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <h2 class="section-title">Top issues</h2>
                <a href="issues" class="small">View all →</a>
            </div>
            @foreach (var i in _topIssues)
            {
                <div class="top-issue" @onclick="() => OpenIssue(i.Id)">
                    <div class="flex-grow-1 min-w-0">
                        <div class="ti-title text-truncate">@i.Title</div>
                        @if (!string.IsNullOrWhiteSpace(i.Culprit))
                        {
                            <div class="ti-culprit text-truncate">@i.Culprit</div>
                        }
                    </div>
                    <div class="text-end">
                        <div class="ti-count">@i.EventCount</div>
                        <div class="ti-culprit">events</div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Projects -->
<h2 class="section-title mb-2">Projects</h2>

@if (_loading && _projects is null)
{
    <p class="text-muted">Loading projects…</p>
}
else if (_projects is { Count: 0 })
{
    <div class="alert alert-info">No events received yet. Once a client posts events they'll show up here.</div>
}
else if (_projects is not null)
{
    <div class="row g-3">
        @foreach (var p in _projects)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 project-card" role="button" @onclick="() => OpenProject(p.ProjectId)">
                    <div class="card-body">
                        <h3 class="h6 card-title text-truncate mb-3" title="@p.ProjectId">@p.ProjectId</h3>
                        <div class="d-flex gap-4">
                            <div>
                                <div class="fs-4 fw-semibold">@p.EventCount</div>
                                <div class="text-muted small">events</div>
                            </div>
                            <div>
                                <div class="fs-4 fw-semibold @(p.ExceptionCount > 0 ? "text-danger" : "")">@p.ExceptionCount</div>
                                <div class="text-muted small">exceptions</div>
                            </div>
                        </div>
                        <div class="text-muted small mt-3">
                            Last event: @p.LastEventAt.ToLocalTime().ToString("g")
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ProjectSummary>? _projects;
    private List<TimeBucket>? _stats;
    private IReadOnlyList<IssueSummary>? _topIssues;
    private CrashFreeStats? _crashFree;
    private int _windowTotal;
    private int _windowExceptions;
    private int _issuesTotal;
    private int _eventsRecent, _eventsPrev, _excRecent, _excPrev;
    private bool _loading;
    private bool _live;
    private bool _subscribed;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Live.EventReceived += OnLiveEvent;
        _subscribed = true;
        try
        {
            await Live.EnsureStartedAsync();
            _live = Live.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
        }
        catch
        {
            _live = false;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _projects = await Api.GetProjectsAsync();
            _stats = (await Api.GetEventsPerHourAsync(hours: 24)).ToList();

            var issues = await Api.GetIssuesAsync(take: 50, status: "Unresolved");
            _issuesTotal = issues.Total;
            _topIssues = issues.Items.OrderByDescending(i => i.EventCount).Take(5).ToList();

            _crashFree = await Api.GetCrashFreeAsync(days: 14);

            RecomputeTotals();
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the API: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnLiveEvent(EventSummary e)
    {
        if (_stats is null || _stats.Count == 0)
            return;

        // New events land in the most recent (last) bucket.
        var last = _stats[^1];
        _stats[^1] = last with
        {
            Total = last.Total + 1,
            Exceptions = last.Exceptions + (string.Equals(e.EventType, "Exception", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
        };
        RecomputeTotals();
        InvokeAsync(StateHasChanged);
    }

    private static string Percent(double rate) => (rate * 100).ToString(rate >= 0.999 ? "0.00" : "0.0") + "%";

    private void RecomputeTotals()
    {
        _windowTotal = _stats?.Sum(b => b.Total) ?? 0;
        _windowExceptions = _stats?.Sum(b => b.Exceptions) ?? 0;

        if (_stats is { Count: > 0 })
        {
            _eventsRecent = _stats[^1].Total;
            _excRecent = _stats[^1].Exceptions;
            _eventsPrev = _stats.Count > 1 ? _stats[^2].Total : 0;
            _excPrev = _stats.Count > 1 ? _stats[^2].Exceptions : 0;
        }
    }

    private static RenderFragment RenderDelta(int recent, int prev) => builder =>
    {
        var d = recent - prev;
        var (cls, text) = d switch
        {
            > 0 => ("up", $"▲ +{d} vs prev hour"),
            < 0 => ("down", $"▼ {d} vs prev hour"),
            _ => ("", "– flat vs prev hour")
        };
        builder.OpenElement(0, "span");
        if (cls.Length > 0) builder.AddAttribute(1, "class", cls);
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static string F(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void OpenProject(string projectId)
        => Nav.NavigateTo($"/events?projectId={Uri.EscapeDataString(projectId)}");

    private void OpenIssue(Guid id) => Nav.NavigateTo($"/issues/{id}");

    public void Dispose()
    {
        if (_subscribed)
            Live.EventReceived -= OnLiveEvent;
    }
}
