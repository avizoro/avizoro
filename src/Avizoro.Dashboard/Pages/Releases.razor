@page "/releases"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Releases — Avizoro</PageTitle>

<h1 class="page-title mb-1">Releases</h1>
<p class="text-muted mb-4">Adoption and stability of every version you shipped. A release below 99% crash-free sessions is highlighted.</p>

<div class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-3">
        <label class="form-label small text-muted mb-1">Project</label>
        <input class="form-control form-control-sm" placeholder="all projects" @bind="_projectId" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small text-muted mb-1">Environment</label>
        <input class="form-control form-control-sm" placeholder="all environments" @bind="_environment" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small text-muted mb-1">Window</label>
        <select class="form-select form-select-sm" @bind="_days">
            <option value="7">7 days</option>
            <option value="14">14 days</option>
            <option value="30">30 days</option>
            <option value="90">90 days</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <button class="btn btn-primary btn-sm w-100" @onclick="LoadAsync">Apply</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_releases is null)
{
    <p class="text-muted">Loading releases…</p>
}
else if (_releases.Count == 0)
{
    <div class="alert alert-info">No releases in this window. Releases appear once events or sessions arrive with a release/version.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>Release</th>
                    <th style="min-width: 9rem">Adoption · 24h</th>
                    <th class="text-end">Crash-free sessions</th>
                    <th class="text-end">Crash-free users</th>
                    <th class="text-end">Sessions</th>
                    <th class="text-end">Exceptions</th>
                    <th class="text-end">New issues</th>
                    <th>Last seen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _releases)
                {
                    var unhealthy = r.CrashFreeSessionRate is < 0.99;
                    <tr class="@(unhealthy ? "avz-row-danger" : "")">
                        <td class="fw-semibold"><code>@r.Release</code></td>
                        <td>
                            @if (r.Adoption is { } adoption)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: .5rem" role="progressbar"
                                         aria-valuenow="@((int)(adoption * 100))" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @(F(adoption * 100))%"></div>
                                    </div>
                                    <span class="small text-muted">@Percent(adoption, 0)</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">–</span>
                            }
                        </td>
                        <td class="text-end @(unhealthy ? "text-danger fw-semibold" : "")">@Rate(r.CrashFreeSessionRate)</td>
                        <td class="text-end">@Rate(r.CrashFreeUserRate)</td>
                        <td class="text-end">@r.Sessions</td>
                        <td class="text-end">@r.Exceptions</td>
                        <td class="text-end">
                            @if (r.NewIssues > 0)
                            {
                                <a href="@IssuesUrl(r.Release)">@r.NewIssues</a>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </td>
                        <td class="small text-nowrap" title="First seen @r.FirstSeen.ToLocalTime().ToString("g")">@r.LastSeen.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? ProjectId { get; set; }

    private string? _projectId;
    private string? _environment;
    private int _days = 30;
    private IReadOnlyList<ReleaseHealth>? _releases;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _projectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _releases = null;
        try
        {
            _releases = await Api.GetReleasesAsync(_projectId, _environment, _days);
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the API: {ex.Message}";
        }
    }

    private string IssuesUrl(string release)
    {
        var url = $"/issues?status=all&release={Uri.EscapeDataString(release)}";
        if (!string.IsNullOrWhiteSpace(_projectId))
            url += $"&projectId={Uri.EscapeDataString(_projectId)}";
        return url;
    }

    private static string Rate(double? rate) => rate is { } r ? Percent(r, r >= 0.999 ? 2 : 1) : "–";

    private static string Percent(double value, int decimals)
        => (value * 100).ToString("F" + decimals, System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string F(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
