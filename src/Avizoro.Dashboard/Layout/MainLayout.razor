@inherits LayoutComponentBase
@implements IDisposable
@inject Avizoro.Dashboard.Services.AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <aside class="avz-sidebar">
        <NavMenu />

        <div class="avz-sidebar-footer">
            <button class="avz-icon-btn" @onclick="ToggleTheme"
                    title="@(_theme == "dark" ? "Switch to light theme" : "Switch to dark theme")"
                    aria-label="Toggle theme">
                @if (_theme == "dark")
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
                    </svg>
                }
            </button>

            <div class="d-flex align-items-center gap-2">
                <a class="avz-icon-btn" href="https://github.com" target="_blank" rel="noopener"
                   title="GitHub" aria-label="GitHub">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.5 9.5 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                    </svg>
                </a>
                @if (Auth.HasToken)
                {
                    <button class="avz-icon-btn w-auto" @onclick="SignOut" title="Sign out">Sign out</button>
                }
            </div>
        </div>
    </aside>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@if (Auth.ChallengeRequired)
{
    <div class="auth-overlay">
        <div class="auth-card">
            <h2>Sign in</h2>
            <p>
                @(Auth.HasToken
                    ? "The saved token was rejected. Enter a valid read token."
                    : "This Avizoro server requires a read token to view data.")
            </p>
            <input type="password" class="form-control" placeholder="Paste your read token"
                   @bind="_token" @bind:event="oninput" @onkeydown="OnKeyDown" />
            <button class="btn btn-primary mt-3" @onclick="SaveAsync"
                    disabled="@string.IsNullOrWhiteSpace(_token)">Continue</button>
        </div>
    </div>
}

@code {
    private string? _token;
    private string _theme = "dark";

    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("ikGetTheme");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("ikSetTheme", _theme);
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_token))
            await SaveAsync();
    }

    private async Task SaveAsync()
    {
        await Auth.SetTokenAsync(_token);
        _token = null;
        // Force a reload so every page re-fetches with the new token.
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task SignOut()
    {
        await Auth.SetTokenAsync(null);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
