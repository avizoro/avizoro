<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Avizoro.AspNetCore</PackageId>
    <Title>Avizoro for ASP.NET Core</Title>
    <Description>Self-hosted error tracking and performance for ASP.NET Core: builder.UseAvizoro(dsn). Captures unhandled request exceptions with request context, per-request breadcrumbs, http.server timings per route, and ILogger errors.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avizoro.Hosting\Avizoro.Hosting.csproj" />
  </ItemGroup>

</Project>
