<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Avizoro.Core</PackageId>
    <Title>Avizoro.Core</Title>
    <Description>Framework-agnostic core of Avizoro — the domain model, service funnel and abstractions for self-hosted .NET crash reporting and observability. Referenced by the platform SDKs (e.g. Avizoro.Maui); has no MAUI dependency.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Opt-in build-time symbol upload, inherited by every Avizoro SDK package. -->
    <None Include="buildTransitive\Avizoro.Core.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
