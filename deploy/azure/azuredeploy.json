{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Avizoro on Azure App Service (Linux containers): the server (SQLite on persistent /home storage) and the dashboard, from the prebuilt GHCR images."
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "[concat('ik', uniqueString(resourceGroup().id))]",
      "maxLength": 40,
      "metadata": { "description": "Prefix for the two web apps: <prefix>-server and <prefix>-dashboard (must be globally unique)." }
    },
    "adminToken": {
      "type": "securestring",
      "minLength": 24,
      "metadata": { "description": "Admin read token for the dashboard/API (e.g. openssl rand -hex 24)." }
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": { "description": "Tag of ghcr.io/avizoro/avizoro-{server,dashboard}." }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [ "B1", "B2", "S1", "P0v3", "P1v3" ],
      "metadata": { "description": "App Service plan size (shared by both apps)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "variables": {
    "planName": "[concat(parameters('namePrefix'), '-plan')]",
    "serverName": "[concat(parameters('namePrefix'), '-server')]",
    "dashboardName": "[concat(parameters('namePrefix'), '-dashboard')]",
    "serverUrl": "[concat('https://', parameters('namePrefix'), '-server.azurewebsites.net')]",
    "dashboardUrl": "[concat('https://', parameters('namePrefix'), '-dashboard.azurewebsites.net')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": { "name": "[parameters('sku')]" },
      "properties": { "reserved": true }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('serverName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux,container",
      "dependsOn": [ "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]" ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|ghcr.io/avizoro/avizoro-server:', parameters('imageTag'))]",
          "alwaysOn": true,
          "healthCheckPath": "/health/ready",
          "appSettings": [
            { "name": "WEBSITES_PORT", "value": "7099" },
            { "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE", "value": "true" },
            { "name": "DOCKER_REGISTRY_SERVER_URL", "value": "https://ghcr.io" },
            { "name": "Database__Provider", "value": "Sqlite" },
            { "name": "ConnectionStrings__Events", "value": "Data Source=/home/data/avizoro.db" },
            { "name": "Auth__ReadToken", "value": "[parameters('adminToken')]" },
            { "name": "Alerts__DashboardUrl", "value": "[variables('dashboardUrl')]" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('dashboardName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux,container",
      "dependsOn": [ "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]" ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|ghcr.io/avizoro/avizoro-dashboard:', parameters('imageTag'))]",
          "appSettings": [
            { "name": "WEBSITES_PORT", "value": "80" },
            { "name": "DOCKER_REGISTRY_SERVER_URL", "value": "https://ghcr.io" },
            { "name": "API_BASE_URL", "value": "[variables('serverUrl')]" }
          ]
        }
      }
    }
  ],
  "outputs": {
    "dashboardUrl": { "type": "string", "value": "[variables('dashboardUrl')]" },
    "serverUrl": { "type": "string", "value": "[variables('serverUrl')]" },
    "dsnTemplate": { "type": "string", "value": "[concat('https://<projectKey>@', parameters('namePrefix'), '-server.azurewebsites.net/<projectId>')]" }
  }
}
