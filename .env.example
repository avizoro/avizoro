# Copy to .env and adjust. `docker compose` reads .env automatically.

# --- Read-side auth (REQUIRED) ---------------------------------------------
# Shared admin token that gates the read API + dashboard. The server runs in
# Production in Docker, so reads FAIL CLOSED until this is set. Use a long
# random value, e.g.  openssl rand -hex 24
AVIZORO_READ_TOKEN=change-me-to-a-long-random-string

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=avizoro
POSTGRES_PASSWORD=avizoro
POSTGRES_DB=avizoro

# --- Host ports -------------------------------------------------------------
SERVER_PORT=7099
DASHBOARD_PORT=8080

# --- Dashboard -> API -------------------------------------------------------
# URL the BROWSER uses to reach the API. Because the dashboard is WebAssembly
# running in the user's browser, this must be host-reachable (not the "server"
# service name). Keep the port in sync with SERVER_PORT; for a remote deploy use
# the public URL, e.g. https://avizoro.example.com
API_BASE_URL=http://localhost:7099

# --- Images -----------------------------------------------------------------
# Tag of the prebuilt GHCR images used by `docker compose pull` (e.g. 1.1.0).
AVIZORO_VERSION=latest
